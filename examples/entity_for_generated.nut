// Generated by L4D2 VScript Visual Prototype
// Target: L4D2 Squirrel 3.0.4

::MyScript <- {};


::MyScript.DemoEntityLoop <- function()
{
    local e = null;
    while ((e = Entities.FindByClassname(e, "player")) != null)
    {
        printl(e.GetName());
    }
    local nearby = null;
    while ((nearby = Entities.FindInSphere(nearby, Vector(0, 0, 0), 500)) != null)
    {
        printl(nearby.GetClassname());
    }
    for (local ent = Entities.First(); ent != null; ent = Entities.Next(ent))
    {
        if (ent.GetClassname() == "player")
        {
            continue;
        }
    }
    foreach (weapon, count in {smg=50, rifle=120})
    {
        printl(weapon + ": " + count);
    }
};
