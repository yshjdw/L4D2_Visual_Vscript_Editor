::L4VP_Utils.TraceRay <- function(start, finish, ignored, mask)
{
    if (start == null || finish == null) return null;
    local tr = {start = start, end = finish, ignore = ignored, mask = mask};
    if (!TraceLine(tr)) return null;
    return tr;
};
::L4VP_Utils.TraceRead <- function(tr, key, fallback)
{
    return tr != null && tr.rawin(key) ? tr[key] : fallback;
};
::L4VP_Utils.TraceHit <- function(tr)
{
    return ::L4VP_Utils.TraceRead(tr, "hit", false);
};
::L4VP_Utils.TracePosition <- function(tr)
{
    return ::L4VP_Utils.TraceRead(tr, "pos", null);
};


::DemoTrace <- function(player)
{
    local trace = ::L4VP_Utils.TraceRay(player.EyePosition(), player.EyePosition() + Vector(1000, 0, 0), player, 1174421507);
    local hit = ::L4VP_Utils.TraceHit(trace);
    local hit_position = ::L4VP_Utils.TracePosition(trace);
    return trace;
};
